# Loumi frontend configuration
# Copy this file to `.env` and adjust as needed.

# Base URL of the backend API that serves the five ML features.
# The frontend appends the feature-specific endpoints defined in src/config/api.ts
# (e.g. /api/disease-detection), so changing this single value re-points all
# features at a different backend without touching any component.
VITE_API_BASE_URL=http://localhost:8000

# Optional: a weather service base URL used by the weather disease prediction
# page to fetch observed/forecast weather. Leave blank to disable live weather
# retrieval and rely on backend-supplied weather instead.
VITE_WEATHER_API_BASE_URL=
